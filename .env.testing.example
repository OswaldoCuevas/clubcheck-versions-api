# PHPUnit siempre carga este archivo y nunca carga .env.
APP_MODE=TEST

# Base de datos aislada para el servidor que recibira pruebas de endpoints.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_DATABASE=clubcheck_test
TEST_DB_USERNAME=root
TEST_DB_PASSWORD=

# Stripe: solamente se aceptan claves de modo test en las pruebas live.
TEST_STRIPE_SECRET_KEY=sk_test_REEMPLAZAR
TEST_STRIPE_PUBLIC_KEY=pk_test_REEMPLAZAR
TEST_STRIPE_PRODUCT_ID=
TEST_STRIPE_TEST_CLOCK_ID=

# Pruebas HTTP seguras (consultas y validaciones que no envian mensajes).
TEST_BASE_URL=http://localhost/clubcheck
TEST_CUSTOMER_JWT=
TEST_CUSTOMER_API_ID=
TEST_STRIPE_BILLING_ID=
RUN_ENDPOINT_TESTS=0

# Round-trip push -> pull. Debe apuntar exclusivamente a la BD de pruebas.
RUN_SYNC_ENDPOINT_TESTS=0
TEST_SYNC_BULK=
TEST_SYNC_PRIMARY_KEY=
TEST_SYNC_RECORD_JSON=

# Compra Stripe de modo test. Crea y luego cancela una suscripcion de prueba.
RUN_STRIPE_LIVE_TEST=0
LIVE_STRIPE_CONFIRM=
TEST_STRIPE_PLAN_LOOKUP_KEY=

# WhatsApp real: esta es la unica prueba que puede generar costo.
RUN_WHATSAPP_LIVE_TEST=0
LIVE_WHATSAPP_CONFIRM=
WHATSAPP_TEST_PHONE=
WHATSAPP_TEST_SUBSCRIPTION_ID=clubcheck-automated-test
