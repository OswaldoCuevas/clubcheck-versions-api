{
    "require": {
        "stripe/stripe-php": "^19.4",
        "phpmailer/phpmailer": "^6.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Controllers\\": "app/Controllers/",
            "Core\\": "app/Core/",
            "Middleware\\": "app/Middleware/",
            "Models\\": "app/Models/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "12.5",
        "guzzlehttp/guzzle": "^8.3"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "phpunit"
        ],
        "test:unit": "phpunit --testsuite unit",
        "test:admin-http": "phpunit --testsuite admin-http-characterization",
        "test:customers-http": "phpunit --testsuite customer-http-characterization"
    }
}
