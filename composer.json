{
    "require": {
        "stripe/stripe-php": "^19.4",
        "phpmailer/phpmailer": "^6.8"
    },
    "require-dev": {
        "phpunit/phpunit": "11.5"
    },
    "scripts": {
        "test": "phpunit -c phpunit.xml",
        "test:unit": "phpunit -c phpunit.xml --testsuite Unit",
        "test:endpoints": "phpunit -c phpunit.xml --testsuite Endpoint",
        "test:live": "phpunit -c phpunit.live.xml"
    }
}
